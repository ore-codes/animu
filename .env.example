DATABASE_URL=postgres://animu:animu@localhost:5433/animu

# Origin allowed to call POST routes. Production: https://www.animu.net (no trailing slash).
# Leave unset on previews and local: the request's own host is used.
APP_ORIGIN=

# Embeddings. "local" runs a small model in-process (development and tests only; it does not run on Vercel).
# "gemini" calls the hosted API (production). Changing provider, model or size means re-running ingest for every show.
EMBEDDING_PROVIDER=local
GEMINI_EMBED_MODEL=
# Optional smaller vectors, for example 768. Cheaper storage.
GEMINI_EMBED_DIMENSIONS=

# Smart ranking and recaps. Without both of these the app falls back to meaning search and plain synopsis excerpts.
GEMINI_API_KEY=
GEMINI_MODEL=
# Hard cap on AI calls per UTC day. At the cap the app drops to the no-AI fallback.
AI_DAILY_CALL_LIMIT=300
