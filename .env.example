DATABASE_URL=postgres://animu:animu@localhost:5433/animu

# Origin allowed to call POST routes, for example https://animu.net
APP_ORIGIN=http://localhost:3000

# Embeddings. "local" runs a small model in-process (dev, tests). "gemini" calls the hosted API (production).
# Changing provider or model means re-running ingest for every show.
EMBEDDING_PROVIDER=local
# Required when EMBEDDING_PROVIDER=gemini
GEMINI_EMBED_MODEL=

# Optional smart ranking and recaps. Without a key the app falls back to meaning search and plain synopsis excerpts.
GEMINI_API_KEY=
GEMINI_MODEL=
# Hard cap on AI calls per UTC day. At the cap the app drops to the no-AI fallback.
AI_DAILY_CALL_LIMIT=300
